{
    "name": "bluetide/wp-amigo-manage",
    "description": "Auditor de inventario y vulnerabilidades para el core, plugins y temas de WordPress",
    "version": "1.0.0",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "BlueTide"
        }
    ],
    "autoload": {
        "psr-4": {
            "WPAmigoManage\\Core\\": "core/",
            "WPAmigoManage\\Dto\\": "dto/",
            "WPAmigoManage\\Http\\": "http/",
            "WPAmigoManage\\Helpers\\": "helpers/",
            "WPAmigoManage\\Includes\\": "includes/",
            "WPAmigoManage\\Providers\\": "providers/",
            "WPAmigoManage\\Exceptions\\": "exceptions/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^7.1"
    }
}
